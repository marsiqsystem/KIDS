{
  "expo": {
    "name": "SET · KIDS",
    "slug": "kids-set",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kids-icon.png",
    "scheme": "kidsset",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "ios": {
      "bundleIdentifier": "org.kidskolkata.set",
      "supportsTablet": false,
      "buildNumber": "10"
    },
    "android": {
      "package": "org.kidskolkata.set",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/images/kids-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B1E2B",
          "image": "./assets/images/kids-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the check-in code on your invigilator's desk, and shows you in a live class when your teacher allows it.",
          "microphonePermission": "The microphone lets you answer in a live class when your teacher allows it.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B1E2B",
          "defaultChannel": "kids-notices"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.kidskolkata.org"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
