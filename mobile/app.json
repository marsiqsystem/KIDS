{
  "expo": {
    "name": "KIDS EDU UDAAN",
    "owner": "iq-systems-and-research-solutions-private-limited",
    "slug": "kids",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-full-1024.png",
    "scheme": "kidsset",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "org.kidskolkata.set",
      "supportsTablet": false,
      "buildNumber": "12",
      "icon": "./assets/images/icon-full-1024.png"
    },
    "android": {
      "package": "org.kidskolkata.set",
      "adaptiveIcon": {
        "backgroundColor": "#0E1F19",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 12,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B1E2B",
          "image": "./assets/images/kids-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the check-in code on your invigilator's desk, and shows you in a live class when your teacher allows it.",
          "microphonePermission": "The microphone lets you answer in a live class when your teacher allows it.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7B1E2B",
          "defaultChannel": "kids-notices"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "apiUrl": "https://www.kidskolkata.org",
      "router": {},
      "eas": {
        "projectId": "c20b99f6-a358-40e4-a01e-4660b7637ff7"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
