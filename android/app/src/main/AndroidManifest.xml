<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The live class.

      Capacitor's BridgeWebChromeClient already asks the student for these at
      the moment the class calls getUserMedia, and grants the web request if
      they agree. What it cannot do is ask for a permission the manifest has
      not declared: Android returns "denied" for those without showing anything.

      So until 11 Sep 2026 a student in the app could only ever LISTEN. Raising
      a hand and being unmuted did nothing, and Jitsi told them to "use the
      camera button in the address bar" - in an app that has no address bar.

      Declared, not requested at launch. A child opening the app to do ten
      questions is never asked for a microphone; the ask happens the first time
      they unmute themselves in a class, which is the moment it makes sense.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      A phone with no camera must still be able to install this and sit in a
      class. Without these two lines the CAMERA permission implies the hardware
      is required, and the Play Store rule follows the manifest even for a
      sideloaded APK.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
