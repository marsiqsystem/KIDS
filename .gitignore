# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal registers — contain coordinator phone numbers and student allocation
# counts, and must not reach this public repo. Centre names/addresses that are
# safe to publish live in src/app/set/centres.ts.
/Centre_and_School_Allocation_Register*.pdf

.vercel
.env*

# the offline written paper's marks, exported from the OMR tool for import into
# Neon (Desktop\KIDS OMR 2026\export_for_web.py). 7,287 children's marks keyed
# by Unique ID — the same class of data as `students`, which is why that table
# is seeded from a workbook outside this repo and never committed. This repo is
# PUBLIC. Keep the export on the machine, hand it to the importer by path.
offline-results.json
scripts/offline-results.json

# Portable working context that moves with this FOLDER, never with git.
# .claude/context/memory holds ~96 notes naming real students, marks, disputes
# and internal decisions; BRIEFING.md summarises them. This repo is PUBLIC.
# See .claude/context/README.md.
/.claude/context/
/.claude/settings.local.json

# Built APKs. Signed or not, a binary does not belong in the repo — the release
# ones go to GitHub Releases, which is also where the website's download link
# points (Vercel bandwidth will not survive 9,655 students x 20-40 MB).
/native/dist/
*.apk

# Signing keys for the Android app. See android/.gitignore — same reasoning,
# repeated here so a keystore left anywhere in the tree is still caught.
*.jks
*.keystore
# and the file that holds its passwords in plain text.
keystore.properties

# Generated per build by native/build-apk.mjs — carries the server URL for
# the no-connection page. Differs between a laptop, preview and production
# build, so it is not a source file.
/native/www/server.js
